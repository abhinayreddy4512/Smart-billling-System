generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  name           String?
  shopName       String?
  ownerName      String?
  phone          String?
  gstNo          String?
  village        String?
  mandal         String?
  district       String?
  state          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  farmers        Farmer[]
  products       Product[]
  stockMovements StockMovement[]
}

model Farmer {
  id                String             @id @default(cuid())
  farmerNo          String             // e.g. "1001"
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  email             String?
  photoUrl          String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  @@unique([userId, farmerNo])
  bills             Bill[]
  cashTransactions  CashTransaction[]
  cropLogs          CropLog[]
  cropSettlements   CropSettlement[]
  annualSettlements AnnualSettlement[]
}

model Product {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String          // 'FERTILIZER' or 'PESTICIDE'
  name           String
  size           String?         // '50kg', '1 Litre', etc.
  quantity       Int             @default(0) // Number of items
  price          Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
}

model StockMovement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  category     String   // 'FERTILIZER' or 'PESTICIDE'
  productName  String
  size         String?
  movementType String   // 'RECEIVED' | 'OPENING_BALANCE' | 'ADJUSTMENT'
  quantity     Int
  price        Float    @default(0)
  date         DateTime @default(now())
  businessYear String   // e.g. "2025-26", "2026-27" (May-April)
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, category])
  @@index([userId, businessYear])
}

model Bill {
  id         String   @id @default(cuid())
  billNo     Int      @default(0)
  farmerId   String
  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  category   String   // 'FERTILIZER' or 'PESTICIDE'
  product    String
  quantity   Int
  price      Float
  total      Float
  photoProof String?  @db.Text
  date       DateTime @default(now())
}

model CashTransaction {
  id         String   @id @default(cuid())
  receiptNo  Int      @default(0)
  farmerId   String
  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  type       String   // 'TAKEN' or 'GIVEN'
  amount     Float
  photoProof String?  @db.Text
  note       String?  // e.g. 'Annual Settlement Payment', 'Carry Forward from 2025-26'
  date       DateTime @default(now())
}

model CropLog {
  id          String   @id @default(cuid())
  logNo       Int      @default(0)
  farmerId    String
  farmer      Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropType    String   // 'COTTON' or 'MIRCHI'
  bagWeights  Json     // array of numbers
  totalWeight Float
  price       Float?   @default(0) // price per kg
  isSettled   Boolean  @default(false)
  date        DateTime @default(now())
}

model CropSettlement {
  id          String   @id @default(cuid())
  farmerId    String
  farmer      Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model AnnualSettlement {
  id                 String   @id @default(cuid())
  farmerId           String
  farmer             Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  periodStart        DateTime
  periodEnd          DateTime
  academicYear       String   @default("") // Cycle label or year
  status             String   @default("MANUALLY_SETTLED") // "MANUALLY_SETTLED" | "AUTOMATICALLY_SETTLED"
  paymentStatus      String   @default("PENDING_DECISION") // "PENDING_DECISION" | "PAID" | "CARRIED_FORWARD"
  totalPurchases     Float    @default(0)
  totalCashTaken     Float    @default(0)
  totalCashGiven     Float    @default(0)
  totalCotton        Float    @default(0)
  totalMirchi        Float    @default(0)
  shopPurchases      Float    @default(0)
  moneyDiff          Float    @default(0)
  unsettledCrops     Float    @default(0)
  principal          Float    @default(0)
  interestRate       Float    @default(0)
  interestAmount     Float    @default(0)
  totalAmount        Float    @default(0)
  generatedReceiptNo Int?
  carryForwardReceiptNo Int?
  createdAt          DateTime @default(now())
}
